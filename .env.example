# Local Docker Compose only. Never reuse this password outside local development.
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
API_PORT=5080
WEB_PORT=3000

# For the API running on the host (export this variable; .NET does not load .env).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=airesearch;Username=airesearch;Password=local-development-only
